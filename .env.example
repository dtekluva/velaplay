# Copy to .env on the server (ops/deploy.sh creates one with random secrets the first time).
POSTGRES_USER=velaplay
POSTGRES_DB=velaplay
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
# Leave as :80 until a domain points at the server, then set e.g. play.example.com and Caddy fetches HTTPS certificates itself.
SITE_ADDRESS=:80
# Let people join the world without an account (handy while testing).
ALLOW_GUESTS=true
# Shared secret for the TURN relay (voice chat). ops/deploy.sh fills in a random one.
TURN_SECRET=change-me
